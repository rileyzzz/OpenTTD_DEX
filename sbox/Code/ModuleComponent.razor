    protected override void OnUpdate()
    {
        base.OnUpdate();

        if (Input.Pressed("LMB"))
        {
            MouseDownCallback?.Invoke((int)MouseButtons.Left);
        }

        if (Input.Released("LMB"))
        {
            MouseUpCallback?.Invoke((int)MouseButtons.Left);
        }

        
        if (Input.Pressed("RMB"))
        {
            MouseDownCallback?.Invoke((int)MouseButtons.Right);
        }

        if (Input.Released("RMB"))
        {
            MouseUpCallback?.Invoke((int)MouseButtons.Right);
        }

        // BuildEvents();
        if (InitOk)
        {
            // Log.Info("loop!");
            Module.DoMainLoop();
