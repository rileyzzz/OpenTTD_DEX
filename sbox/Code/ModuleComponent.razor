    public static void VideoResize(int width, int height)
    {
        // Framebuf = Texture.Create(width, height, ImageFormat.RGBA8888)
        Framebuf = Texture.Create(width, height, ImageFormat.ABGR8888)
            .WithDynamicUsage()
            .Finish();

        Canvas.Texture = Framebuf;
        Log.Info($"Set framebuffer texture {width}x{height}");
    }

    public static void VideoShutdown()
    {

    }

    public static void Blit(ReadOnlySpan<byte> video, int bpp, int srcPitch, int imgX, int imgY, int w, int h)
    {
        int byteStride = (bpp / 8);

        int bufferSize = (w * h) * byteStride;
        if (ScratchImgBuffer == null || ScratchImgBuffer.Length < bufferSize)
        {
            ScratchImgBuffer = new Color32[bufferSize];
        }

        int srcOffset = (imgY * srcPitch) + imgX * byteStride;
        int bufOffset = 0;
        for (int y = 0; y < h; y++)
        {
            for (int x = 0; x < w; x++)
            {
                Color32 color = default;
                if (bpp == 8)
                {
                    int i = video[srcOffset + x];
                    color = Palette[(int)i];
                }
                else if (bpp == 16)
                {
                    ushort i = BinaryPrimitives.ReadUInt16LittleEndian(video.Slice(srcOffset + x * 2, 2));
                    color = Palette[(int)i];
                }
                else if (bpp == 24)
                {
                    uint i = ((uint)video[srcOffset + (x * 3) + 0])
                           | ((uint)video[srcOffset + (x * 3) + 1] << 8)
                           | ((uint)video[srcOffset + (x * 3) + 2] << 16);
                    // color = Palette[(int)i];
                    color = Color.FromRgb(i).ToColor32();
                }
                else if (bpp == 32)
                {
                    uint i = BinaryPrimitives.ReadUInt32LittleEndian(video.Slice(srcOffset + x * 4, 4));
                    // color = Palette[(int)i];
                    color = Color.FromRgba(i).ToColor32();
                }
                else
                {
                    Log.Error("Unknown bpp!");
                }

                ScratchImgBuffer[bufOffset++] = color;
            }

            srcOffset += srcPitch;
        }

        if (Framebuf != null)
        {
            // Log.Info("Blit");
            Framebuf.Update(ScratchImgBuffer, imgX, imgY, w, h);
        }
    }


