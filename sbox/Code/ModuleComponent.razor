    public static void UpdateSound(ReadOnlySpan<byte> mixbuf)
    {
        // Don't get behind.
        if (Snd.QueuedSampleCount > SndSamples.Length * 4)
            return;

        // Copy sound buffer.
        for (int i = 0; i < SndSamples.Length; i++)
        {
            SndSamples[i] =
                (short)((mixbuf[i * 2 + 0]) |
                (mixbuf[i * 2 + 1] << 8));
        }

        Snd.WriteData(SndSamples);

        // SoundUpdate = true;
    }

    public static void UpdatePalette(ReadOnlySpan<byte> range, int offset)
    {
        int count = range.Length / 4;
        for (int i = 0; i < count; i++)
        {
            uint col = BinaryPrimitives.ReadUInt32LittleEndian(range.Slice(i * 4, 4));
            Palette[offset + i] = Color.FromRgb(col).ToColor32();
        }
        // palette.CopyTo(Palette, offset);
    }

	  public static void VideoInit(int width, int height)
